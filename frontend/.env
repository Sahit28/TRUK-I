VITE_API_URL=http://localhost:5000/api

// Suponiendo que ya tienes el modelo Camion importado
app.get('/api/camiones', async (req, res) => {
  try {
    const camiones = await Camion.find().sort({ fecha: -1 });
    res.json(camiones);
  } catch (error) {
    res.status(500).json({ error: 'Error al obtener camiones' });
  }
});